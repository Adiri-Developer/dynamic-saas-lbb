{
	frankenphp
}

http://:9000 {
	root * /app/public
	encode zstd gzip

	@blockedPhp {
		path_regexp (?i)\.php(?:/|$)
		not path /index.php
	}
	respond @blockedPhp 404

	# Nginx terminates TLS and sets this header before proxying.
	map {header.X-Forwarded-Proto} {laravel_https} {
		https on
		default off
	}

	php_server {
		env HTTPS {laravel_https}
	}
}
